// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SYSTEM_MODE {
  ACTIVE
  MAINTENANCE
  DOWN
}

model Settings {
  systemId   String      @id @map("system_id")
  systemMode SYSTEM_MODE @map("system_mode")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime?   @updatedAt @map("updated_at")

  @@map("settings")
}

model User {
  id              String  @id @unique @default(uuid())
  username        String  @unique
  displayUsername String  @map("display_username")
  email           String  @unique @map("email")
  emailVerified   Boolean @default(false) @map("email_verified")
  name            String  @default("Name not set")
  image           String?

  role      String
  banned    Boolean
  banReason String?      @map("ban_reason")
  banExpires DateTime?   @map("ban_expires")

  twoFactorEnabled Boolean @map("two_factor_enabled")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  accounts        Account[]
  sessions        Session[]
  simulations     Simulation[]
  passwordResets  UserPasswordReset[]
  twoFactors TwoFactor[]

  @@index([username])
  @@index([email])
  @@map("user")
}

model TwoFactor {
  id String  @id @unique @default(uuid())
  userId String @map("user_id")
  secret String
  backupCodes String @map("backup_codes")

  user User @relation(fields: [userId], references: [id])
  @@map("two_factor")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String? @map("ip_address")
  impersonatedBy String? @map("impersonated_by")
  userAgent String? @map("user_agent")
  createdAt DateTime @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("session")
}

model Account {
  id        String   @id
  userId    String   @map("user_id")
  accountId String   @map("account_id")
  providerId String  @map("provider_id")
  accessToken String? @map("access_token")
  refreshToken String? @map("refresh_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope String? @map("scope")
  idToken String? @map("id_token")
  password String? @map("password")
  createdAt DateTime @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id        String   @id
  identifier String
  value     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("verification")
}

model UserPasswordReset {
  id         String    @id @unique @default(uuid())
  userId     String    @map("user_id")
  used       Boolean   @default(false)
  usable     Boolean   @default(true)
  validUntil DateTime  @default(dbgenerated("NOW() + interval '15 min'")) @map("valid_until")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_password_reset")
}

enum SIMULATION_TYPE {
  acpype
  apo
}

enum SIMULATION_STATUS {
  QUEUED
  RUNNING
  COMPLETED
  CANCELED
  ERRORED
  GENERATED
}

model Simulation {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  moleculeName  String            @map("molecule_name")
  ligandITPName String?           @map("ligand_itp_name")
  ligandPDBName String?           @map("ligand_pdb_name")
  type          SIMULATION_TYPE
  startedAt     DateTime?         @map("started_at")
  endedAt       DateTime?         @map("ended_at")
  status        SIMULATION_STATUS @default(QUEUED)
  errorCause    String?           @map("error_cause")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime?         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([moleculeName])
  @@index([ligandITPName])
  @@index([ligandPDBName])
  @@index([type])
  @@map("simulation")
}
